# Google AI Studio key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.5-flash
GEMINI_MODEL=

# Google Cloud key with ONLY the Books API enabled. Required: the keyless
# shared quota is routinely exhausted (429).
GOOGLE_BOOKS_API_KEY=

# Upstash Redis for per-IP rate limiting. Unset = rate limiting DISABLED.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
